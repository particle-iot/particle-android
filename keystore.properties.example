# Copy this file to "keystore.properties" (which is git-ignored) and fill in your
# real upload keystore details to produce a signed release build/AAB.
# Without keystore.properties present, the release build is left unsigned.
storeFile=/absolute/path/to/your/upload.keystore
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
